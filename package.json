{
  "name": "mayimbe",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "predev": "npm run archive:build",
    "dev": "nuxt dev",
    "prebuild": "npm run archive:build",
    "build": "nuxt build",
    "pregenerate": "npm run archive:build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "archive:validate": "node scripts/validate-content.ts",
    "archive:build": "node scripts/build-archive.ts",
    "test": "vitest run tests/unit tests/integration",
    "test:visual": "playwright test",
    "bake:notebook": "node scripts/bake-notebook-textures.mjs",
    "bake:notebook:parity": "node scripts/bake-notebook-textures.mjs --out tests/visual/.bake-png --type image/png --buckets 390x844,1440x900 --profile standard --profile pocket"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "three": "0.169.0",
    "vue": "3.5.42",
    "vue-router": "5.2.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.13.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
