/* Stage 2 pocket-notebook-only visual refinements.
   These selectors are intentionally scoped to the experiment route DOM. */

/* The F3-03 assets were baked at 840px wide with 5px spine corners and 20px
   outer corners. Use container-width units so settled and moving covers clip
   to that exact physical ratio at every rendered pocket size. */
.pocket-lab .pocket-notebook {
  container-type: inline-size;
}

.pocket-lab .pocket-notebook .notebook-cover,
.pocket-lab .pocket-notebook .turning-cover .turning-cover__face,
.pocket-lab .pocket-notebook .notebook-board {
  border-radius: .595238095cqw 2.380952381cqw 2.380952381cqw .595238095cqw;
}

/* Page-one PaperV2 trauma approximation using only reusable Stage-1 wear
   exports. The mature concept contains multiple stain/tide events rather than
   one generic mark, so duplicate the same static assets at different scales
   and offsets instead of flattening a complete page. Apply the same marks to
   the temporary outgoing page so its damage does not disappear mid-turn. */
.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-water-stain']::before,
.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-water-stain']::after,
.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-humidity-bloom']::before,
.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-foxing-heavy']::before,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-water-stain']::before,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-water-stain']::after,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-humidity-bloom']::before,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-foxing-heavy']::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: inherit;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  pointer-events: none;
}

.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-water-stain']::before,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-water-stain']::before {
  opacity: .62;
  transform: translate(22%, 23%) scale(.58);
  transform-origin: center;
}

.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-water-stain']::after,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-water-stain']::after {
  opacity: .45;
  transform: translate(-31%, 38%) scale(.38);
  transform-origin: center;
}

.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-humidity-bloom']::before,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-humidity-bloom']::before {
  opacity: .62;
  transform: translate(0, 18%) scale(1.06);
  transform-origin: center bottom;
}

.pocket-notebook[data-paper-history='page-one-trauma']
  .resting-page .paper-wear[data-wear-layer='wear-foxing-heavy']::before,
.turning-page[data-turn-paper-history='page-one-trauma']
  .paper-wear[data-wear-layer='wear-foxing-heavy']::before {
  opacity: .50;
  transform: translate(20%, -16%) scale(.72);
  transform-origin: center;
}
